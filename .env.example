# Wind Accuracy Dashboard — Environment Variables
#
# Copy this file to .env and fill in the values for your environment.
# For local Docker Compose, the defaults below work without modification.
# For Render deployment, see the T7 section of docs/IMPLEMENTATION_PLAN.md.

# ── Backend ──────────────────────────────────────────────────────────────────

# Path to the SQLite database inside the container.
# Default: /app/backend/data/wind_data.db  (set by backend/Dockerfile)
WIND_DB_PATH=/app/backend/data/wind_data.db

# Exact origin of the frontend (scheme + host + optional port, NO trailing slash).
# Must match the URL you open in the browser.
# Production (Render): set to the Render static site URL, e.g. https://wind-dashboard.onrender.com
FRONTEND_ORIGIN=http://localhost:5173

# Decision cutoff time in HH:MM UTC (provisional).
# Forecasts published after this time the day before delivery are excluded.
DECISION_CUTOFF_TIME=09:20

# ── Frontend (build-time, baked into Vite output) ────────────────────────────

# URL of the backend API. Baked in at `npm run build` time — NOT a runtime var.
# Production (Render): set to your Render web service URL, e.g. https://wind-backend.onrender.com
VITE_BACKEND_URL=http://localhost:8000
